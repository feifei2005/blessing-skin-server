# EdgeOne SPA Environment Variables
# Copy this to .env or set these in your build environment
#
# === Passport OAuth2 Setup (run on your PHP backend) ===
# 1. Run database migrations:  php artisan migrate
# 2. Generate Passport RSA keys:  php artisan passport:keys
# 3. Create a public OAuth client:
#    php artisan passport:client --public
#    Copy the generated "Client ID" and set it as REACT_APP_OAUTH_CLIENT_ID below.
# 4. For existing deployments, add a new public client:
#    php artisan passport:client --public --name="SPA Client"
#
# API base URL of your PHP backend (e.g., https://api.your-cvm.com)
REACT_APP_API_BASE=

# OAuth2 Passport public client ID (created via `php artisan passport:client --public`)
REACT_APP_OAUTH_CLIENT_ID=

# EdgeOne Edge Function environment variables
# Set these in EdgeOne Pages dashboard or edge function configuration

# Comma-separated list of allowed CORS origins (must include your EdgeOne Pages domain)
ALLOWED_ORIGINS=

# Backend API base URL for the edge function proxy (e.g., https://api.your-cvm.com)
API_BASE_URL=
