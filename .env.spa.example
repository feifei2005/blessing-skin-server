# ============================================================
# Blessing Skin SPA 部署环境变量
# ============================================================
# 复制此文件为 .env 或在构建环境中设置这些变量
#
# === 后端 Passport OAuth2 配置步骤 ===
# 1. 运行数据库迁移:  php artisan migrate
# 2. 生成 Passport RSA 密钥:  php artisan passport:keys
# 3. 创建 SPA 公共 OAuth 客户端（二选一）:
#    方式一（推荐）: php artisan db:seed --class=PassportClientSeeder
#      - 可通过 SPA_URL 环境变量指定 SPA 域名（默认使用 APP_URL）
#    方式二: php artisan passport:client --public
#      - 手动复制生成的 Client ID
# 4. 将生成的 Client ID 设置为下方的 REACT_APP_OAUTH_CLIENT_ID
#
# === 重要：后端 .env 也需要配置 ===
# 确保后端 .env 中设置了 CORS_ALLOWED_ORIGINS，值为 SPA 的域名
# 例如: CORS_ALLOWED_ORIGINS=https://skin.example.com
#
# ============================================================

# PHP 后端的 API 地址（例如 https://api.your-cvm.com）
# 此值会在构建时注入，也会写入 config.json 供运行时使用
REACT_APP_API_BASE=

# OAuth2 Passport 公共客户端 ID（通过上述步骤 3 创建）
REACT_APP_OAUTH_CLIENT_ID=

# ============================================================
# EdgeOne Edge Function 环境变量
# 在 EdgeOne Pages 控制台或边缘函数配置中设置
# ============================================================

# 允许的 CORS 来源（逗号分隔，必须包含你的 EdgeOne Pages 域名）
ALLOWED_ORIGINS=

# 边缘函数代理的后端 API 地址（例如 https://api.your-cvm.com）
API_BASE_URL=

# ============================================================
# 运行时配置说明
# ============================================================
# SPA 启动时会从 /config.json 加载运行时配置:
#   {"apiBase": "https://api.your-cvm.com"}
#
# Dockerfile.spa 会自动根据 REACT_APP_API_BASE 生成此文件。
# 手动部署时，请确保在部署目录下放置正确的 config.json。
