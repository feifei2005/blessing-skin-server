# EdgeOne SPA Environment Variables
# Copy this to .env or set these in your build environment

# API base URL of your PHP backend (e.g., https://api.your-cvm.com)
REACT_APP_API_BASE=

# OAuth2 Passport client ID (created via `php artisan passport:client`)
REACT_APP_OAUTH_CLIENT_ID=

# OAuth2 Passport client secret (password grant only)
REACT_APP_OAUTH_CLIENT_SECRET=
